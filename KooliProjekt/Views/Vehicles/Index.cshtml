@model KooliProjekt.Data.PagedResult<KooliProjekt.Data.Vehicle>
@{
    ViewData["Title"] = "Vehicles";
}
<h1>Vehicles</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Add New Vehicle</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Manufacturer</th>
            <th>Model</th>
            <th>License Plate</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Results)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Manufacturer)</td>
                <td>@Html.DisplayFor(modelItem => item.Model)</td>
                <td>@Html.DisplayFor(modelItem => item.LicensePlate)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@(await Component.InvokeAsync<KooliProjekt.Components.PagerViewComponent>(Model))