@model KooliProjekt.Data.Invoice

@{
    ViewData["Title"] = "Delete Invoice";
}

<h1>Delete Invoice</h1>

<div class="alert alert-danger">
    <h3>Are you sure you want to delete this invoice?</h3>
</div>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.InvoiceNo)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.InvoiceNo)</dd>
        
        <dt class="col-sm-2">Customer</dt>
        <dd class="col-sm-10">@Model.Customer?.Name</dd>
        
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.InvoiceDate)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.InvoiceDate)</dd>
        
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DueDate)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.DueDate)</dd>
        
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Subtotal)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Subtotal)</dd>
        
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Shipping)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Shipping)</dd>
        
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.GrandTotal)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.GrandTotal)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>