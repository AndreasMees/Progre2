@model KooliProjekt.Data.PagedResult<KooliProjekt.Data.Invoice>
@{
    ViewData["Title"] = "Invoices";
}
<h1>Invoices</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Create New Invoice</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Invoice Number</th>
            <th>Customer</th>
            <th>Invoice Date</th>
            <th>Due Date</th>
            <th>Grand Total</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Results)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.InvoiceNo)</td>
                <td>@item.Customer?.Name</td>
                <td>@Html.DisplayFor(modelItem => item.InvoiceDate)</td>
                <td>@Html.DisplayFor(modelItem => item.DueDate)</td>
                <td>@Html.DisplayFor(modelItem => item.GrandTotal)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@(await Component.InvokeAsync<KooliProjekt.Components.PagerViewComponent>(Model))