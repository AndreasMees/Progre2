@model KooliProjekt.Models.OperationsIndexModel
@{
    ViewData["Title"] = "Operations";
}
<h1>Operations</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Create New Operation</a>
</p>
<form method="get">
    <div class="form-group">
        <label class="control-label">Keyword</label>
        <input asp-for="Search.Keyword" class="form-control" />
    </div>
    <div class="form-group">
        <label class="control-label">Status</label>
        <select asp-for="Search.Status" class="form-control" asp-items="Html.GetEnumSelectList<KooliProjekt.Data.OperationStatus>()">
            <option value="">-- All --</option>
        </select>
    </div>
    <div class="form-group mt-2">
        <button class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Reset</a>
    </div>
</form>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Vehicle</th>
            <th>Operation Type</th>
            <th>Assigned Employee</th>
            <th>Date</th>
            <th>Status</th>
            <th>Cost</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Data.Results)
        {
            <tr>
                <td>@item.Vehicle?.LicensePlate</td>
                <td>@item.OperationType?.Name</td>
                <td>@item.AssignedEmployee?.UserName</td>
                <td>@item.Date.ToShortDateString()</td>
                <td>
                    @if (item.Status == KooliProjekt.Data.OperationStatus.Pending)
                    {
                        <span class="badge bg-warning">Pending</span>
                    }
                    else if (item.Status == KooliProjekt.Data.OperationStatus.InProgress)
                    {
                        <span class="badge bg-info">In Progress</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                </td>
                <td>@item.Cost</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@(await Component.InvokeAsync<KooliProjekt.Components.PagerViewComponent>(Model.Data))