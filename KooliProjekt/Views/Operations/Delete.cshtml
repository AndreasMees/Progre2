@model KooliProjekt.Data.Operation

@{
    ViewData["Title"] = "Delete Operation";
}

<h1>Delete Operation</h1>

<div class="alert alert-danger">
    <h3>Are you sure you want to delete this operation?</h3>
</div>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Vehicle</dt>
        <dd class="col-sm-10">@Model.Vehicle?.LicensePlate</dd>
        
        <dt class="col-sm-2">Operation Type</dt>
        <dd class="col-sm-10">@Model.OperationType?.Name</dd>
        
        <dt class="col-sm-2">Assigned Employee</dt>
        <dd class="col-sm-10">@Model.AssignedEmployee?.UserName</dd>
        
        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Date)</dd>
        
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
        
        <dt class="col-sm-2">Cost</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Cost)</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>