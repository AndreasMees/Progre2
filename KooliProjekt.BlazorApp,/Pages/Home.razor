@page "/"
@using KooliProjekt.PublicAPI
@inject IApiClient ApiClient

<PageTitle>Sõidukite Haldus (CRUD) - Blazor</PageTitle>

<div class="container mt-4">
    <h1>Sõidukite Haldus (Blazor WebAssembly)</h1>
    <p>Andmete reaalajas lisamine, muutmine ja kustutamine läbi ühise API kliendi.</p>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Tõrge!</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Edukas!</strong> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <div class="card my-4 shadow-sm">
        <div class="card-header @(formModel.Id == 0 ? "bg-primary" : "bg-warning") text-white">
            <h5>@(formModel.Id == 0 ? "Lisa uus sõiduk" : $"Muuda sõidukit (ID: {formModel.Id})")</h5>
        </div>
        <div class="card-body">
            <EditForm Model="@formModel" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Tootja (Manufacturer)</label>
                        <InputText @bind-Value="formModel.Manufacturer" class="form-control" placeholder="nt. Audi, BMW" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Mudel (Model)</label>
                        <InputText @bind-Value="formModel.Model" class="form-control" placeholder="nt. A6, 320i" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Numbrimärk (License Plate)</label>
                        <InputText @bind-Value="formModel.LicensePlate" class="form-control" placeholder="nt. 123XYZ" />
                    </div>
                </div>

                <div class="mt-3 text-end">
                    @if (formModel.Id != 0)
                    {
                        <button type="button" class="btn btn-secondary me-2" @onclick="CancelEdit">Tühista</button>
                    }
                    <button type="submit" class="btn @(formModel.Id == 0 ? "btn-success" : "btn-warning")">
                        @(formModel.Id == 0 ? "Salvesta uus" : "Uuenda andmeid")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    <h3>Olemasolevad sõidukid</h3>
    @if (vehicles == null && string.IsNullOrEmpty(errorMessage))
    {
        <p><em>Laadin andmeid...</em></p>
    }
    else if (vehicles != null && !vehicles.Any())
    {
        <p>Sõidukeid ei leitud. Lisa esimene sõiduk üleval oleva vormi kaudu!</p>
    }
    else if (vehicles != null)
    {
        <table class="table table-striped table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Tootja</th>
                    <th>Mudel</th>
                    <th>Numbrimärk</th>
                    <th class="text-center" style="width: 200px;">Tegevused</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in vehicles)
                {
                    <tr>
                        <td>@vehicle.Id</td>
                        <td>@vehicle.Manufacturer</td>
                        <td>@vehicle.Model</td>
                        <td>@vehicle.LicensePlate</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-warning me-2" @onclick="() => PrepareEdit(vehicle)">
                                <i class="bi bi-pencil"></i> Muuda
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteVehicle(vehicle.Id)">
                                <i class="bi bi-trash"></i> Kustuta
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Vehicle>? vehicles;
    private Vehicle formModel = new Vehicle();

    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    // 1. NIMEKIRJA LAADIMINE
    private async Task LoadData()
    {
        var result = await ApiClient.List();
        if (result.HasError)
        {
            errorMessage = result.Error;
        }
        else
        {
            vehicles = result.Value ?? new List<Vehicle>();
        }
    }

    // 2. LISAMINE JA MUUTMINE (Salvestamine)
    private async Task HandleValidSubmit()
    {
        errorMessage = null;
        successMessage = null;

        // Kontroll, et väljad poleks tühjad
        if (string.IsNullOrWhiteSpace(formModel.Manufacturer) ||
            string.IsNullOrWhiteSpace(formModel.Model) ||
            string.IsNullOrWhiteSpace(formModel.LicensePlate))
        {
            errorMessage = "Palun täida kõik kohustuslikud väljad!";
            return;
        }

        // ApiClient tuvastab ise Id järgi, kas tegu on POST või PUT päringuga
        var result = await ApiClient.Save(formModel);

        if (result.HasError)
        {
            errorMessage = result.Error;
        }
        else
        {
            successMessage = formModel.Id == 0 ? "Uus sõiduk edukalt lisatud!" : "Sõiduki andmed edukalt uuendatud!";
            formModel = new Vehicle(); // Tühjendab vormi
            await LoadData();          // Värskendab nimekirja tabelis
        }
    }

    // 3. MUUTMISE ETTEVALMISTUS (Andmete vormi laadimine)
    private void PrepareEdit(Vehicle vehicle)
    {
        errorMessage = null;
        successMessage = null;

        // Teeme objektist koopia, et tabelis andmed ei muutuks enne reaalselt salvestamist
        formModel = new Vehicle
        {
            Id = vehicle.Id,
            Manufacturer = vehicle.Manufacturer,
            Model = vehicle.Model,
            LicensePlate = vehicle.LicensePlate
        };
    }

    private void CancelEdit()
    {
        formModel = new Vehicle();
    }

    // 4. KUSTUTAMINE
    private async Task DeleteVehicle(int id)
    {
        errorMessage = null;
        successMessage = null;

        var result = await ApiClient.Delete(id);
        if (result.HasError)
        {
            errorMessage = result.Error;
        }
        else
        {
            successMessage = "Sõiduk edukalt süsteemist kustutatud!";

            // Kui kustutati parajasti muudetav objekt, tühjendame ka vormi
            if (formModel.Id == id)
            {
                formModel = new Vehicle();
            }

            await LoadData(); // Värskendab nimekirja
        }
    }
}