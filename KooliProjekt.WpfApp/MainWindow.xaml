<Window x:Class="KooliProjekt.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KooliProjekt.WpfApp"
        mc:Ignorable="d"
        Title="Sõidukite Haldus (MVVM)" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"></ColumnDefinition>
            <ColumnDefinition Width="400"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <DataGrid 
            x:Name="TodoListsGrid"
            Grid.Column="0"
            ItemsSource="{Binding Lists}"
            SelectedItem="{Binding SelectedItem}"
            AutoGenerateColumns="True"
            Margin="5"/>

        <StackPanel Margin="10" Grid.Column="1">
            <TextBlock FontWeight="Bold" Margin="0,0,0,5">ID (Automaatne)</TextBlock>
            <TextBlock Text="{Binding SelectedItem.Id}" Margin="0,0,0,10" Background="#FFEAEAEA" Padding="3"></TextBlock>

            <TextBlock FontWeight="Bold" Margin="0,0,0,5">Tootja</TextBlock>
            <TextBox Text="{Binding SelectedItem.Manufacturer, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="3"></TextBox>

            <TextBlock FontWeight="Bold" Margin="0,0,0,5">Mudel</TextBlock>
            <TextBox Text="{Binding SelectedItem.Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="3"></TextBox>

            <TextBlock FontWeight="Bold" Margin="0,0,0,5">Numbrimärk</TextBlock>
            <TextBox Text="{Binding SelectedItem.LicensePlate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" Padding="3"></TextBox>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="10">
                <Button Command="{Binding NewCommand}" Margin="5" Padding="15,5" Background="LightBlue">New</Button>
                <Button Command="{Binding SaveCommand}" Margin="5" Padding="15,5" Background="LightGreen">Save</Button>
                <Button Command="{Binding DeleteCommand}" Margin="5" Padding="15,5" Background="LightCoral">Delete</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>