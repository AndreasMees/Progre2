<Window x:Class="KooliProjekt.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KooliProjekt.WpfApp"
        mc:Ignorable="d"
        Title="Sõidukite Haldus" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Sõidukite loend (API)" FontSize="16" FontWeight="Bold"/>
            <ListBox Grid.Row="1" x:Name="ListBoxVehicles" SelectionChanged="ListBoxVehicles_SelectionChanged" FontSize="14" Margin="0,5"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                <Button x:Name="BtnRefresh" Content="Uuenda loendit" Width="110" Height="30" Margin="0,0,10,0" Click="BtnRefresh_Click"/>
                <Button x:Name="BtnDelete" Content="Kustuta valitud" Width="110" Height="30" Background="#FFF17676" Click="BtnDelete_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Margin="10" VerticalAlignment="Top">
            <Label Content="Sõiduki andmed" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <Label Content="ID (Automaatne serveris):"/>
            <TextBox x:Name="TxtId" IsReadOnly="True" Background="#FFEAEAEA" Margin="0,0,0,10" Padding="3"/>

            <Label Content="Tootja:"/>
            <TextBox x:Name="TxtManufacturer" Margin="0,0,0,10" Padding="3"/>

            <Label Content="Mudel:"/>
            <TextBox x:Name="TxtModel" Margin="0,0,0,10" Padding="3"/>

            <Label Content="Numbrimärk:"/>
            <TextBox x:Name="TxtLicensePlate" Margin="0,0,0,20" Padding="3"/>

            <Button x:Name="BtnSave" Content="Salvesta uus objekt" Height="35" FontWeight="Bold" Background="#FF98EE99" Margin="0,0,0,10" Click="BtnSave_Click"/>
            <Button x:Name="BtnClear" Content="Tühjenda väljad (Uus auto)" Height="25" Click="BtnClear_Click"/>
        </StackPanel>
    </Grid>
</Window>